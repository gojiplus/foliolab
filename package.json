    "check": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "generate:org": "tsx scripts/generate-portfolio.ts",
    "build:action": "esbuild action/index.ts --bundle --platform=node --target=node24 --format=cjs --legal-comments=eof --outfile=action-dist/index.cjs",
    "check:action": "npm run build:action && git diff --exit-code -- action-dist/index.cjs"
  },
